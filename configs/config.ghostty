# Config generated by Ghostty Config
# https://ghostty.zerebos.com

background = #1c1c1f
background-blur = true
bell-audio-volume = 0.3
bold-color = bright
clipboard-paste-protection = false
clipboard-read = allow
confirm-close-surface = false
cursor-color = #E342E5
cursor-style = underline
cursor-style-blink = true
cursor-text = #1c1c1f
focus-follows-mouse = true
font-family = JetBrainsMono Nerd Font
gtk-single-instance = true
gtk-toolbar-style = flat
gtk-wide-tabs = false
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
palette = 0=#241f31
palette = 1=#c01c28
palette = 2=#2ec27e
palette = 3=#f5c211
palette = 4=#1e78e4
palette = 5=#9841bb
palette = 6=#0ab9dc
palette = 7=#c0bfbc
palette = 8=#5e5c64
palette = 9=#ed333b
palette = 10=#57e389
palette = 11=#f8e45c
palette = 12=#51a1ff
palette = 13=#c061cb
palette = 14=#4fd2fd
palette = 15=#f6f5f4
selection-background = #ffffff
selection-foreground = #1c1c1f
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo
tab-inherit-working-directory = false
theme = Adwaita Dark
window-height = 32
window-padding-x = 4
window-padding-y = 4
window-show-tab-bar = never
window-subtitle = working-directory
window-theme = ghostty
window-width = 110
